# Copy to .env in the repository root. Every value here has a working default in
# backend/app/core/config.py; what you almost certainly have to set is DATABASE_URL.

APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8787
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Optional. When set, every API route except /api/health requires this value in an
# `X-Coscientist-Token` or `Authorization: Bearer` header. Leave empty for the normal
# single-operator local setup.
APP_AUTH_TOKEN=

# The one database this application owns. The name `ai_coscientist_gui` and the role
# `ai_coscientist_gui_app` are asserted by the migrations and by the test suite, so that a
# mistyped DSN cannot point the engine at another database. Create them with:
#   psql -U postgres -c "CREATE ROLE ai_coscientist_gui_app LOGIN PASSWORD 'changeme';"
#   psql -U postgres -c "CREATE DATABASE ai_coscientist_gui OWNER ai_coscientist_gui_app;"
DATABASE_URL=postgresql+psycopg://ai_coscientist_gui_app:changeme@127.0.0.1:5432/ai_coscientist_gui

# Where runs are written: one directory per run, named by engine_run_id. The directory must
# be called `runs` and sit under an engine root, because the artifact projection resolves a
# run's engine root as this directory's parent. Defaults to ./engines/runs.
# COSCIENTIST_RUNS_ROOT=/srv/oracle/engines/runs

# Import archived runs into the database on boot. This repository ships no run archive, so
# leave it off; set it to true only if you have a run archive of your own to import.
IMPORT_ON_STARTUP=false
# IMPORT_ARCHIVE_ROOT=/srv/oracle/archive/imported-runs

# Demo runs use a scripted model with no latency and no network calls. Set a per-call delay
# in seconds to watch the live view fill up at a human pace. Affects `runner: demo` only.
COSCIENTIST_DEMO_LATENCY=0

# How long the SSE stream stays silent before sending a keep-alive comment.
SSE_HEARTBEAT_SECONDS=15

# The free, scripted runner. Leave it on: it is how you learn the interface, and what the
# browser smoke test exercises.
FAKE_HARNESS_ENABLED=true
# Must be true before a run may call a real model through the Claude or Codex CLI. Demo
# runs work either way. Real runs are opt-in by design.
REAL_HARNESS_ENABLED=false

# What the browser client calls, and where "sign in" points when a gateway fronts the app.
VITE_API_BASE_URL=http://127.0.0.1:8787/api
# VITE_GATEWAY_URL=https://oracle.example.com/

# Identity. With IDENTITY_REQUIRE_GATEWAY off (the default) every request is this user,
# which is the right setting for a single-operator install. To put Oracle behind an
# authenticating reverse proxy instead, see docs/reverse-proxy-sso.md.
LOCAL_IDENTITY_USERNAME=operator
IDENTITY_TRUST_HEADERS=true
IDENTITY_REQUIRE_GATEWAY=false
IDENTITY_ADMIN_GROUP=admin
# GATEWAY_SECRET=
