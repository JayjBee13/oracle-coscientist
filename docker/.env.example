# Copy this file to docker/.env before the first `docker compose up`. Keep the real file
# local: it holds credentials, and .gitignore already excludes it.

# The bundled db service creates this role and database on an empty volume from
# docker/init-db.sql. Change the password in BOTH places, or point this at an existing
# PostgreSQL instance and start only `app` and `proxy`.
DATABASE_URL=postgresql+psycopg://ai_coscientist_gui_app:changeme@db:5432/ai_coscientist_gui
POSTGRES_PASSWORD=postgres

# Demo runs are always available. Real model calls remain opt-in: set this to true only
# after signing the CLIs in inside the container
#   docker compose exec app claude login
#   docker compose exec app codex login
FAKE_HARNESS_ENABLED=true
REAL_HARNESS_ENABLED=false

# This repository ships no run archive.
IMPORT_ON_STARTUP=false

# Single-operator deployment: every request is this user. To put Oracle behind an
# authenticating reverse proxy, set IDENTITY_REQUIRE_GATEWAY=true and GATEWAY_SECRET, and
# read docs/reverse-proxy-sso.md first — a supplied but wrong secret always fails closed.
LOCAL_IDENTITY_USERNAME=operator
IDENTITY_TRUST_HEADERS=true
IDENTITY_REQUIRE_GATEWAY=false
# GATEWAY_SECRET=

# Browser authentication, when something upstream owns it. Leave APP_AUTH_TOKEN blank so
# Oracle does not present a second login.
APP_AUTH_TOKEN=

# The canonical public origin used for browser-origin checks. Compose interpolation reads
# this from the invoking shell or from `docker compose --env-file docker/.env ...`; a
# service-level env_file alone does not supply interpolation variables.
ORACLE_PUBLIC_ORIGIN=http://localhost:18000
ORACLE_WEB_PORT=18000
ORACLE_API_PORT=18001
