# Copy to docker/db.env before the first `docker compose up`. Only the bundled `db` service
# reads this file, so the application's own secrets stay out of the database container.
#
# Both values are used ONLY on first boot, by docker/init-db.sh, against an empty data
# volume. Changing them later changes nothing: to start over, run
#   docker compose down && docker volume rm oracle_db

# The Postgres superuser password.
POSTGRES_PASSWORD=postgres

# The password for the role Oracle connects as. If you change it, change it in DATABASE_URL
# in docker/.env to match.
APP_DB_PASSWORD=changeme
